{
    "name": "threatguard-desktop",
    "version": "1.0.0",
    "description": "ThreatGuard Desktop Application - Security Operations Center",
    "main": "src/main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder",
        "build:windows": "electron-builder --windows",
        "build:linux": "electron-builder --linux",
        "build:mac": "electron-builder --mac"
    },
    "keywords": [
        "threatguard",
        "security",
        "soc",
        "ids",
        "desktop"
    ],
    "author": "ThreatGuard Team",
    "license": "MIT",
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1"
    },
    "dependencies": {
        "fs-extra": "^11.2.0"
    },
    "build": {
        "appId": "com.threatguard.desktop",
        "productName": "ThreatGuard",
        "directories": {
            "output": "dist"
        },
        "files": [
            "src/**/*",
            "assets/**/*",
            "package.json"
        ],
        "win": {
            "target": "portable",
            "icon": "assets/icon.ico"
        },
        "linux": {
            "target": ["AppImage"],
            "icon": "assets/icon.png",
            "category": "Utility"
        },
        "mac": {
            "target": "dmg",
            "icon": "assets/icon.icns"
        }
    }
}
