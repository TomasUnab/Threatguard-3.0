[Unit]
Description=ThreatGuard API Service
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=threatguard
WorkingDirectory=/opt/threatguard
Environment="DATABASE_URL=postgresql+psycopg2://threatguard_user:secure_password_2024!@localhost:5432/threatguard_db"
Environment="REDIS_HOST=localhost"
Environment="REDIS_PORT=6379"
ExecStart=/opt/threatguard/venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
