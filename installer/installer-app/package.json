{
    "name": "threatguard-installer",
    "version": "1.0.0",
    "description": "ThreatGuard Native Installer with GUI",
    "main": "src/main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder",
        "build:inno": "powershell -NoProfile -ExecutionPolicy Bypass -File build\\build_inno.ps1",
        "build:linux": "electron-builder --linux",
        "build:windows": "powershell -Command \"npm install --prefix '../../PAGINA WEB'; npm run build:css --prefix '../../PAGINA WEB'; electron-builder --windows\"",
        "build:all": "powershell -NoProfile -ExecutionPolicy Bypass -File build\\build_all.ps1",
        "clean:builds": "powershell -NoProfile -ExecutionPolicy Bypass -File build\\clean_old_builds.ps1"
    },
    "keywords": [
        "threatguard",
        "installer",
        "security",
        "ids",
        "snort"
    ],
    "author": "ThreatGuard Team",
    "license": "MIT",
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1"
    },
    "dependencies": {
        "fs-extra": "^11.2.0"
    },
    "build": {
        "appId": "com.threatguard.installer",
        "productName": "ThreatGuard Installer",
        "directories": {
            "output": "dist"
        },
        "files": [
            "src/**/*",
            "package.json"
        ],
        "asarUnpack": [
            "src/backend/**/*"
        ],
        "extraResources": [
            {
                "from": "../../src",
                "to": "app/src",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "resources_to_package/threatguard_api.py",
                "to": "app/threatguard_api.py"
            },
            {
                "from": "resources_to_package/requirements.txt",
                "to": "app/requirements.txt"
            },
            {
                "from": "../../PAGINA WEB",
                "to": "app/PAGINA WEB",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "../../config",
                "to": "app/config",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "../../assets",
                "to": "assets",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "build/Output/ThreatGuard_Uninstaller.exe",
                "to": "ThreatGuard_Uninstaller.exe"
            },
            {
                "from": "build/uninstall.ps1",
                "to": "uninstall.ps1"
            }
        ],
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "category": "Utility"
        },
        "win": {
            "target": "portable",
            "forceCodeSigning": false,
            "requestedExecutionLevel": "requireAdministrator"
        }
    }
}