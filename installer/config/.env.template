# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=threatguard_db
DATABASE_USER=threatguard_user
DATABASE_PASSWORD=secure_password_2024!
DATABASE_URL=postgresql+psycopg2://threatguard_user:secure_password_2024!@localhost:5432/threatguard_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
