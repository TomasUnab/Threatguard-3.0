# ThreatGuard - Git Ignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environment
venv/
ENV/
env/
.venv

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
logs/*.log
logs/Alamacenamiento/*.log
logs/features/*.log

# Database
*.db
*.sqlite
*.sqlite3
threatguard.db

# Models (archivos grandes)
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt
!models/.gitkeep

# Data
data/*.csv
data/*.pcap
data/*.json
!data/.gitkeep

# Configuración sensible
.env
*.ini
config/*.ini
!config/config.ini.example

# Backups
*.backup
*.bak
config/*.backup.*

# Docker
.dockerignore

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# Pytest
.pytest_cache/
.coverage
htmlcov/

# OS
Thumbs.db
.DS_Store

# Temporary files
*.tmp
*.temp
temp/
tmp/

# Reports generados
reports/*.pdf
reports/*.csv
reports/*.xlsx

# Elasticsearch data
elasticsearch_data/

# Redis dumps
dump.rdb

# Snort logs
snort_logs/
*.alert

# Certificados y claves
*.pem
*.key
*.crt
*.p12

# Archivos de configuración local
local_settings.py
settings_local.py
