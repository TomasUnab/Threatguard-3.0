[SERVER]
HOST = 0.0.0.0
PORT = 5000
DEBUG = False

[DATABASE]
DB_TYPE = postgresql
DB_HOST = localhost
DB_PORT = 5432
DB_NAME = threatguard_master
DB_USER = postgres
DB_PASSWORD = YOUR_DATABASE_PASSWORD_HERE

[REDIS]
REDIS_HOST = localhost
REDIS_PORT = 6379
REDIS_PASSWORD = YOUR_REDIS_PASSWORD_HERE

[OPENVAS]
OPENVAS_HOST = localhost
OPENVAS_PORT = 9390
OPENVAS_USER = admin
OPENVAS_PASSWORD = YOUR_OPENVAS_PASSWORD_HERE

[SECURITY]
SECRET_KEY = YOUR_SECRET_KEY_HERE_GENERATE_A_SECURE_RANDOM_STRING
JWT_ALGORITHM = HS256
