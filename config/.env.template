# ThreatGuard Configuration
# =======================

# Database
DATABASE_URL=postgresql://threatguard_user:${DATABASE_PASSWORD}@127.0.0.1:5432/threatguard_db

# API
API_HOST=127.0.0.1
API_PORT=${API_PORT}
SECRET_KEY=${SECRET_KEY}
JWT_SECRET=${JWT_SECRET}
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend
FRONTEND_PORT=${FRONTEND_PORT}

# Snort
SNORT_INTERFACE=${INTERFACE}
SNORT_LOG_DIR=C:\Snort\log
SNORT_CONFIG_DIR=C:\Snort\etc

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
