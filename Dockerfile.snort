FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Instalar dependencias básicas
RUN apt-get update && apt-get install -y \
    git \
    build-essential \
    cmake \
    libpcap-dev \
    libpcre3-dev \
    zlib1g-dev \
    libhwloc-dev \
    libluajit-5.1-dev \
    libssl-dev \
    pkg-config \
    wget \
    flex \
    bison \
    libdumbnet-dev \
    libpcre2-dev \
    liblzma-dev \
    && rm -rf /var/lib/apt/lists/*

# Instalar libdaq
WORKDIR /tmp
RUN git clone https://github.com/snort3/libdaq.git && \
    cd libdaq && \
    ./bootstrap && \
    ./configure && \
    make && \
    make install && \
    ldconfig

# Clonar y compilar Snort 3
WORKDIR /tmp
RUN git clone https://github.com/snort3/snort3.git && \
    cd snort3 && \
    ./configure_cmake.sh --prefix=/usr/local && \
    cd build && \
    make -j$(nproc) && \
    make install && \
    ldconfig

# Crear directorios
RUN mkdir -p /var/log/snort /usr/local/etc/snort/rules

# Copiar configuración
COPY config/snort.lua /usr/local/etc/snort/snort.lua
COPY config/local.rules /usr/local/etc/snort/rules/local.rules

# Limpiar
RUN rm -rf /tmp/*

WORKDIR /var/log/snort

# Script de inicio
RUN echo '#!/bin/bash' > /start-snort.sh && \
    echo 'INTERFACE=${INTERFACE:-eth0}' >> /start-snort.sh && \
    echo 'echo "Starting Snort on interface: $INTERFACE"' >> /start-snort.sh && \
    echo 'touch /var/log/snort/alert_fast.txt' >> /start-snort.sh && \
    echo 'chmod 666 /var/log/snort/alert_fast.txt' >> /start-snort.sh && \
    echo 'ln -sf /var/log/snort/alert_fast.txt /var/log/snort/alert' >> /start-snort.sh && \
    echo 'exec snort -c /usr/local/etc/snort/snort.lua -i "$INTERFACE" -A alert_fast -l /var/log/snort -q' >> /start-snort.sh && \
    chmod +x /start-snort.sh

CMD ["/start-snort.sh"]
